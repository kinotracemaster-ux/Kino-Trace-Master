php_value upload_max_filesize 1024M
php_value post_max_size 1100M
php_value memory_limit 1024M
php_value max_execution_time 600
php_value max_input_time 600

# Bloquear acceso a archivos sensibles
# md: la documentación (docs/, MAPA_TECNICO.md...) describe la arquitectura y hallazgos de seguridad
# ps1/ktdata/ktsync/lock: herramientas y paquetes del modo local
<FilesMatch "\.(db|sql|zip|env|log|json|md|ps1|ktdata|ktsync|lock)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
